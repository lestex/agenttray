#!/bin/sh
# Launches atcli.py with a Python 3.13 or later. Homebrew installs
# python@3.13 as `python3.13` only — the plain `python3` on the PATH is often
# Apple's much older one — so look for the versioned names first.
#
# Homebrew links this file onto the PATH, so follow symlinks to find the
# script that sits next to the real file.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd)

for python in python3.15 python3.14 python3.13 python3; do
  if command -v "$python" >/dev/null 2>&1 &&
    "$python" -c 'import sys; sys.exit(sys.version_info < (3, 13))' 2>/dev/null; then
    exec "$python" "$here/atcli.py" "$@"
  fi
done

echo "atcli: needs Python 3.13 or later. Try: brew install python@3.13" >&2
exit 1
